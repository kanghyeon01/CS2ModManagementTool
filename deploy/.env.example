# This repository's checkout on the NAS/server (the containers run its code; owned by uid 10001).
REPO_DIR=/volume1/docker/cs2mmt/CS2ModManagementTool
# Folder holding controller.toml, secrets.toml, mods.toml and sentinel.conf (chmod 600 the secrets).
CONFIG_DIR=/volume1/docker/cs2mmt/config
# Folder for the state databases and logs.
DATA_DIR=/volume1/docker/cs2mmt/data
